# Docker Compose configuration for the local MySQL service only.
# apps/api's DATABASE_URL (see apps/api/.env.example) must reference these
# same values: mysql://MYSQL_USER:MYSQL_PASSWORD@localhost:MYSQL_PORT/MYSQL_DATABASE

MYSQL_DATABASE=open_food
MYSQL_USER=open_food
MYSQL_PASSWORD=open_food
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
