# API server
NODE_ENV=development
PORT=4000

# Must match the root .env.example MySQL values (database, user, password, port).
# This user has schema privileges on the local dev database only (see
# docker/mysql-init/grant-dev-privileges.sql), which `prisma migrate dev`
# needs to create and drop its temporary shadow database.
DATABASE_URL="mysql://open_food:open_food@localhost:3306/open_food"

# Web app origin allowed to call this API (CORS).
WEB_ORIGIN="http://localhost:3000"

# Stripe test mode — see https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
STRIPE_MONTHLY_PRICE_ID="price_placeholder"
STRIPE_CHECKOUT_SUCCESS_URL="http://localhost:3000/subscription/success"
STRIPE_CHECKOUT_CANCEL_URL="http://localhost:3000/subscription/cancel"
